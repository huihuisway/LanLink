# ============ LanLink 边缘节点配置（复制为 node.env）============

# 控制面 WS 地址
CONTROL_URL=ws://127.0.0.1:5100/ws/node

# 可选：覆盖自动选择的配置文件路径；默认优先读取当前目录的 node.env，否则读取 .env
# LANLINK_NODE_ENV=/etc/lanlink/node.env

# 节点 token（必须在控制面 NODE_TOKENS 白名单里）
NODE_TOKEN=dev-node-token

# 玩家可见节点名称（下发给控制面 / Mod / 大厅展示；修改后重启边缘节点生效）
NODE_NAME=本地节点

# 节点公网地址（下发给 Mod / 客人使用）
PUBLIC_ADDR=127.0.0.1

# 隧道端口（全节点固定一个，TCP + UDP 同号）
TUNNEL_PORT=20000

# 房间公网端口池（TCP + UDP 同号）
# 支持逗号分隔的多个范围：20001-20099,30001-30099
PORT_RANGE=20001-20099

# 带宽上限（Mbps，上报给控制面）
MBPS_LIMIT=30

# 节点向控制面发送心跳的间隔（毫秒）
HEARTBEAT_MS=10000

# 是否要求用户登录才能使用此节点（true/false，上报给控制面）
REQUIRES_LOGIN=false

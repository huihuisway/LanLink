# ============ LanLink 控制面配置 ============

# 运行环境（生产部署必须设为 production）
NODE_ENV=development

# HTTP + WS 升级端口（/ws/mod、/ws/node 挂在同一端口）
PORT=5100

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lanlink
MYSQL_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 节点 token 白名单（逗号分隔；第 i 个 token 注册的节点 id 为 node-i）
NODE_TOKENS=dev-node-token

# 社区节点凭据：优先读取 JSON 文件，否则读取 JSON 环境变量
COMMUNITY_TOKENS_FILE=
COMMUNITY_TOKENS_JSON=

# CORS 允许来源（逗号分隔；生产环境必须显式配置）
CORS_ALLOWED_ORIGINS=

# LanLink 服务端/控制面版本（缺省读取 package.json version）
LANLINK_SERVER_VERSION=

# Mod 版本提示
MOTD=欢迎使用 LanLink 联机中继
VERSION_LATEST=0.13.0
VERSION_MIN=0.13.0
VERSION_URL=https://forum.example.com/lanlink-download

# Mod 可用的 STUN 服务器地址，逗号分隔
STUN_SERVERS=

# 阿里云 ESA 会将客户端 IP 写入 X-Forwarded-For 首位；控制面会直接使用该地址。
# 请确保 ESA 或最后一层代理覆盖该请求头，而不是保留客户端自带的值。

# 节点访问策略：未登录也能看到 login 节点，但不能使用
# 示例：{"default_access":"anonymous","nodes":{"node-2":{"access":"login","region":"华东","tags":["login"]}}}
NODE_ACCESS_CONFIG_JSON=

# 论坛 quick-code 登录桥接
FORUM_BASE_URL=http://localhost:4000
FORUM_EXTERNAL_API_KEY=
FORUM_QUICK_CODE_PATH=/api/external/v1/lanlink/quick-code/validate
FORUM_VERIFY_ENDPOINT=/api/auth/verify
FORUM_VERIFICATION_PAGE_URL=https://forum.example.com/verify-phone

# MindAuth 设备授权已废弃，仅旧版客户端过渡使用
MINDAUTH_BASE_URL=
MINDAUTH_CLIENT_ID=lanlink-mod
MINDAUTH_CLIENT_SECRET=

LANLINK_TOKEN_SECRET=dev-lanlink-token-secret
LANLINK_TOKEN_TTL_SECONDS=2592000

# 连接生命周期与节点健康检查
ROOM_GRACE_MS=60000
NODE_HEARTBEAT_TIMEOUT_MS=30000
NODE_SWEEP_MS=5000
NODE_OPEN_TIMEOUT_MS=10000
